-pub(crate) const SERVER_BASE_URL: &str = if IS_SERVER_LOCAL {
+const DEFAULT_SERVER_BASE_URL: &str = if IS_SERVER_LOCAL {
 	"http://localhost:8484"
 } else {
 	"https://s-d-br.sadan.zip"
 };
 
-pub(crate) const LIST_BUILDS_ENDPOINT: &str =
-	formatc!("{SERVER_BASE_URL}/builds");
+thread_local! {
+	static SERVER_BASE_URL: RefCell<String> =
+		RefCell::new(DEFAULT_SERVER_BASE_URL.to_owned());
+}
+
+/// Points every request at another explorer_server compatible host.
+#[wasm_bindgen]
+pub fn set_server_base_url(url: &str) {
+	SERVER_BASE_URL.with_borrow_mut(|base| {
+		url.trim_end_matches('/').clone_into(base);
+	});
+}
+
+fn server_base_url() -> String {
+	SERVER_BASE_URL.with_borrow(Clone::clone)
+}
+
+#[expect(non_snake_case)]
+pub(crate) fn LIST_BUILDS_ENDPOINT() -> String {
+	format!("{}/builds", server_base_url())
+}
 
 #[expect(non_snake_case)]
 pub(crate) fn FULL_BUNDLE_ENDPOINT(build_hash: &str) -> String {
-	format!("{SERVER_BASE_URL}/build/{build_hash}/full")
+	format!("{}/build/{build_hash}/full", server_base_url())
 }
